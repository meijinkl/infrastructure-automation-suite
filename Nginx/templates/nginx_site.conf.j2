server {
    listen       {{ nginx_port }} default_server;
    listen       [::]:{{ nginx_port }} default_server;

    server_name  {{ nginx_server_name }};

    root   {{ nginx_root }};
    index  index.html;

    access_log /var/log/nginx/{{ nginx_site_name }}.access.log;
    error_log  /var/log/nginx/{{ nginx_site_name }}.error.log;

    location / {
        try_files $uri $uri/ =404;
    }
}